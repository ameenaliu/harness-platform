# ProductVideos credentials — keep this file out of git.
# Copy to .env (not committed) and replace placeholder values.

# ── ElevenLabs (Phase 4 narrator + /translate for en + 31 other languages) ──
# Get a key at https://elevenlabs.io/app/settings/api-keys
# ⚠ Starter tier ($5/mo) required for commercial use — posting to social media counts.
ELEVENLABS_API_KEY=sk_paste_your_real_key_here

# ── 9jaLingo (only used by /translate for Yoruba / Hausa / Igbo / Nigerian Pidgin) ──
# Get a key at https://www.9jalingo.org/dashboard
# Optional — only required if you call /translate with yo / ha / ig / pcm.
# When unset, those four languages downgrade to captions-only (translated text, no voice; dub externally).
NAIJALINGO_API_KEY=nl-paste_your_real_key_here

# Optional future credentials:
# FIGMA_PAT=figd_paste_your_figma_token_here
# CLOUDFLARE_R2_ACCESS_KEY=...
# CLOUDFLARE_R2_SECRET_KEY=...
